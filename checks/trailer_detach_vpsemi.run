# drive-check.md standard trailer run: flat; 1 s idle; 6 s throttle; 2 s throttle 0.3 with
# detach=1 (Ctrl+B on its first frame); 5 s brake (the free trailer runs into the truck)
car vpsemi
world flat
start 0 0 0 0
paint 0
trailer on
seg 1.0
seg 6.0 throttle=1
seg 2.0 throttle=0.3 detach=1
seg 5.0 brake=1
